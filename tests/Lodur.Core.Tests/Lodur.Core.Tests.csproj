<Project Sdk="Microsoft.NET.Sdk">

  <!-- References only Lodur.Core: the core tests build and run with no physics engine present (invariant core-engine-free). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The allocation tests count bytes per tick: TieredPGO instruments the first tier and allocates while the background tier-up lands, at a time no tick count predicts. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lodur.Core\Lodur.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Content Include="pain-box-golden.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
